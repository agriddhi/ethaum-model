# EthAum AI engine — optional.
# Leave blank and the site runs fully on the deterministic rules engine
# (src/lib/ai.ts) — no key required for the demo.
# Add one of the two and the same API routes (/api/ai) upgrade to live LLM
# assistance for classification, qualification prose, match reasoning,
# quote audits and reminders.

# Google Gemini (free tier) — preferred
GEMINI_API_KEY=

# or OpenRouter
OPENROUTER_API_KEY=

# Optional model override
# ETHAUM_MODEL=gemini-2.0-flash
